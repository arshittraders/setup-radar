{"id":"l3","who":"G","text":"पर तेरे घर में तो कोई कुत्ता है ही नहीं!","mood":"shock","lmood":"smug","laugh":0,"sfx":"whoosh","emoji":"","scene":"class"},
{"id":"l4","who":"B","text":"इसीलिए तो कल रात कॉपी मैंने खुद खाई।","mood":"smug","lmood":"shock","laugh":1,"sfx":"boing","emoji":"🐶","scene":"class"},
{"id":"l5","who":"G","text":"छी! कॉपी खा गया? कैसी लगी?","mood":"disgust","lmood":"smug","laugh":0,"sfx":"","emoji":"","scene":"class"},
