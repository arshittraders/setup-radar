{
  "rewrites": [
    {
      "source": "/api/ev",
      "destination": "/api/hub?r=ev"
    },
    {
      "source": "/api/dl",
      "destination": "/api/hub?r=dl"
    },
    {
      "source": "/api/lead",
      "destination": "/api/hub?r=lead"
    },
    {
      "source": "/api/sales",
      "destination": "/api/hub?r=sales"
    },
    {
      "source": "/api/admin",
      "destination": "/api/hub?r=admin"
    },
    {
      "source": "/api/hist",
      "destination": "/api/hub?r=hist"
    },
    {
      "source": "/api/shorts",
      "destination": "/api/hub?r=shorts"
    },
    {
      "source": "/download",
      "destination": "/landing.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/apk/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"SetupRadar.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
